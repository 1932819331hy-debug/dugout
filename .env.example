# Copy to .env and fill in. Never commit .env.
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
GUARDIAN_API_KEY=
# Optional
OPENROUTER_API_KEY=
HF_TOKEN=
# LLM (open-weight models only). Defaults: Poolside Laguna-S 2.1 on OpenRouter's free tier (uses OPENROUTER_API_KEY),
# falling back to a local Ollama model. Chosen on docs/backtests/writer_llm.md.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=poolside/laguna-s-2.1:free
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=qwen2.5:3b
# Only for a hosted OpenAI-compatible endpoint (e.g. OpenRouter free open-weight models); Ollama needs none
LLM_API_KEY=
# Optional self-hosted SearXNG for news search
SEARXNG_URL=
# Optional local path to the PFF FC World Cup 2022 download (free sign-up, not redistributable)
PFF_DATA_DIR=
